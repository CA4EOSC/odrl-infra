cv1:accreditedTrainingCompleted a skos:Concept ;
    skos:definition "Before performing an action on an asset the user must have completed relevant, accredited training"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty"@en ;
    skos:prefLabel "AccreditedTrainingCompleted"@en ;
    skos:scopeNote "The action to be performed on the asset is authorised only for persons who have received appropriate and sufficient training. The training needs can refer to certification frameworks and certificates or proof of completion of a specific course. [how would you define acceptable values for this? Or is this boolean, with the actual test performed elsewhere?]"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:anonymise a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-anonymize> ;
    skos:exactMatch odrl:anonymize ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Constraint? \"For example, to remove identifying particulars for statistical or for other comparable purposes, or to use the Asset without stating the author/source.\""@en ;
    skos:prefLabel "anonymise"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:associateWithResearchProject a skos:Concept ;
    skos:definition "The access to the resource is limited to specific research projects"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty"@en ;
    skos:prefLabel "AssociateWithResearchProject"@en ;
    skos:scopeNote "The user or agent will be granted access to the agent only if the credetials are associated to specific research projects"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:citeData a skos:Concept ;
    skos:definition "If the asset is used in the project context, the relevant project outputs need to cite the dataset"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty during project"@en ;
    skos:prefLabel "CiteData"@en ;
    skos:scopeNote "The project outputs need to cite the dataset in outputs (e.g. papers, derived datasets,...) where it can be reasonably argued that the dataset has contributed to the generation of new intellectual property."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:credentialDisclosure a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Prohibition (must not share password)"@en ;
    skos:prefLabel "CredentialDisclosure"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:depositDerivedDataProduct a skos:Concept ;
    skos:definition "Derived data products need to be deposited in a repository"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty"@en ;
    skos:prefLabel "DepositDerivedDataProduct"@en ;
    skos:scopeNote "The derived datasets need to be curated and preserved by depositing them in a repository."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:destroyData a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty at end of project"@en ;
    skos:prefLabel "DestroyData"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:encryptDataLocally a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty e.g. must encrypt data on local device"@en ;
    skos:prefLabel "EncryptDataLocally"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:identifyAnIndividualHouseholdOrOrganisation a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Prohibition"@en ;
    skos:prefLabel "Identify an individual, household or organisation"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:mutuallyExclusiveAnalysis a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Prohibition (e.g. can analyse dataset x but not in conjunction with dataset y)"@en ;
    skos:prefLabel "MutuallyExclusiveAnalysis"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:notify a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty e.g. of non-compliance or breach"@en ;
    skos:prefLabel "Notify"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:procureThirdPartyApproval a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty (refinement specifies who and payload)"@en ;
    skos:prefLabel "ProcureThirdPartyApproval"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:reproduce a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-reproduce> ;
