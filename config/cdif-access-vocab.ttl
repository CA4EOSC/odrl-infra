    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv2:ResearchAndDevelopment a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:definition "Purposes associated with conducting research and development for new methods, products, or services"@en ;
    skos:exactMatch dpv:ResearchAndDevelopment ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:narrower cv2:AcademicResearch,
        cv2:CommercialResearch,
        cv2:NonCommercialResearch,
        cv2:ScientificResearch ;
    skos:prefLabel "ResearchAndDevelopment"@en .

cv2:Purpose a skos:Concept ;
    skos:definition "The end-goal or reason for which personal data is processed."@en ;
    skos:exactMatch dpv:Purpose ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:narrower cv2:CommercialPurpose,
        cv2:CommunicationManagement,
        cv2:CustomerManagement,
        cv2:EnforceSecurity,
        cv2:HumanResourceManagement,
        cv2:Marketing,
        cv2:NonCommercialPurpose,
        cv2:OrganisationGovernance,
        cv2:Personalisation,
        cv2:PublicBenefit,
        cv2:RecordManagement,
        cv2:ResearchAndDevelopment,
        cv2:ServiceProvision,
        cv2:VendorManagement ;
    skos:prefLabel "Purpose"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv2> .

<https://odrl.codata.org/cv2> a skos:ConceptScheme ;
    dct:created "2026-11-04"^^xsd:date ;
    dct:description "Purposes used as constraints on CDIF actions, re-using Data Privacy Vocabulary (DPV) purpose concepts."@en ;
    dct:source <https://w3id.org/dpv/modules/purposes> ;
    dct:title "CDIF Purpose Constraints (CV2)"@en ;
    skos:hasTopConcept cv2:Purpose .

<https://odrl.codata.org/cv4> a skos:ConceptScheme ;
    dct:created "2026-11-04"^^xsd:date ;
    dct:description "Actions that an assignee must perform (ODRL duties) before or while exercising a permission in a CDIF access policy."@en ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-Duty> ;
    dct:title "CDIF Duty Actions (CV4)"@en ;
    skos:hasTopConcept cv4:anonymise,
        cv4:authenticate,
        cv4:compensation,
        cv4:completeRegistration,
        cv4:designateResponsiblePerson,
        cv4:getEthicsApproval,
        cv4:obtainCompletedAgreement,
        cv4:payment,
        cv4:provisionSecureEnvironment,
        cv4:pseudonymise,
        cv4:thirdPartyAuthorization,
        cv4:verifyAccreditation,
        cv4:verifyProjectContext,
        cv4:verifyTraining .

<https://odrl.codata.org/cv3> a skos:ConceptScheme ;
    dct:created "2026-11-04"^^xsd:date ;
    dct:description "Other constraints describing the scope of applicability of a CDIF access policy: the ODRL left operands selected for CDIF, and broader restriction categories (environment, legal, usage context, person, identity, role, financial) still under investigation."@en ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-LeftOperand> ;
    dct:title "CDIF Other Constraints (CV3)"@en ;
    skos:hasTopConcept cv3:EnvironmentalRestriction,
        cv3:FinancialRestrictions,
        cv3:IdentityAndAccessRestrictions,
        cv3:LegalAndRegulatoryRestrictions,
        cv3:PersonRestrictions,
        cv3:RoleRestrictions,
        cv3:UsageContextRestrictions,
        cv3:absolutePosition,
        cv3:absoluteSize,
        cv3:absoluteSpatialPosition,
        cv3:absoluteTemporalPosition,
        cv3:count,
        cv3:dateTime,
        cv3:delayPeriod,
        cv3:deliveryChannel,
        cv3:device,
        cv3:elapsedTime,
        cv3:event,
        cv3:fileFormat,
        cv3:industry,
        cv3:language,
        cv3:location,
        cv3:media,
        cv3:meteredTime,
        cv3:payAmount,
        cv3:percentage,
        cv3:product,
        cv3:purpose,
        cv3:recipient,
        cv3:resolution,
        cv3:spatial,
        cv3:spatialCoordinates,
        cv3:system,
        cv3:systemDevice,
        cv3:timeInterval,
        cv3:unitOfCount,
        cv3:version,
        cv3:virtualLocation .

