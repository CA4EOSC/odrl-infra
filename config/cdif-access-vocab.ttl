@prefix cc: <http://creativecommons.org/ns#> .
@prefix cv1: <https://odrl.codata.org/cv1/> .
@prefix cv2: <https://odrl.codata.org/cv2/> .
@prefix cv3: <https://odrl.codata.org/cv3/> .
@prefix cv4: <https://odrl.codata.org/cv4/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://odrl.codata.org/cv1/collection/cdifExtension> a skos:Collection ;
    skos:member cv1:accreditedTrainingCompleted,
        cv1:aiAnalysis,
        cv1:aiCuration,
        cv1:aiSearch,
        cv1:analysisDeviceInstrument,
        cv1:apiAccess,
        cv1:associateWithResearchProject,
        cv1:browse,
        cv1:citeData,
        cv1:credentialDisclosure,
        cv1:depositDerivedDataProduct,
        cv1:destroyData,
        cv1:download,
        cv1:encryptDataLocally,
        cv1:extractWord,
        cv1:identifyAnIndividualHouseholdOrOrganisation,
        cv1:linkToOtherData,
        cv1:modify,
        cv1:mutuallyExclusiveAnalysis,
        cv1:notify,
        cv1:onlineAnalysis,
        cv1:procureThirdPartyApproval,
        cv1:reArchive,
        cv1:republish,
        cv1:reshare,
        cv1:searchInTheContent,
        cv1:secondaryUse,
        cv1:secureTransfer,
        cv1:share,
        cv1:signAcceptAgreement,
        cv1:storeData,
        cv1:submitAnalysisOutputsForChecking,
        cv1:takeScreenShot,
        cv1:view ;
    skos:prefLabel "CDIF-specific actions"@en .

<https://odrl.codata.org/cv1/collection/dutyActions> a skos:Collection ;
    skos:member cv1:accreditedTrainingCompleted,
        cv1:analysisDeviceInstrument,
        cv1:associateWithResearchProject,
        cv1:citeData,
        cv1:depositDerivedDataProduct,
        cv1:destroyData,
        cv1:encryptDataLocally,
        cv1:notify,
        cv1:procureThirdPartyApproval,
        cv1:signAcceptAgreement,
        cv1:submitAnalysisOutputsForChecking ;
    skos:prefLabel "Actions typically used in an ODRL Duty"@en .

<https://odrl.codata.org/cv1/collection/odrlCommon> a skos:Collection ;
    skos:member cv1:acceptTracking,
        cv1:adHocSharing,
        cv1:aggregate,
        cv1:annotate,
        cv1:anonymise,
        cv1:append,
        cv1:archive,
        cv1:concurrentUse,
        cv1:copy,
        cv1:delete,
        cv1:derivativeWorks,
        cv1:derive,
        cv1:digitize,
        cv1:display,
        cv1:distribute,
        cv1:distribution,
        cv1:execute,
        cv1:export,
        cv1:extract,
        cv1:extractChar,
        cv1:extractPage,
        cv1:give,
        cv1:grantUse,
        cv1:include,
        cv1:index,
        cv1:inform,
        cv1:install,
        cv1:move,
        cv1:play,
        cv1:present,
        cv1:preview,
        cv1:print,
        cv1:read,
        cv1:reproduce,
        cv1:reproduction,
        cv1:reviewPolicy,
        cv1:sell,
        cv1:stream,
        cv1:synchronize,
        cv1:textToSpeech,
        cv1:transform,
        cv1:translate,
        cv1:watermark,
        cv1:write,
        cv1:writeTo ;
    skos:prefLabel "Actions from the ODRL Common Vocabulary"@en .

<https://odrl.codata.org/cv1/collection/permissionActions> a skos:Collection ;
    skos:member cv1:storeData ;
    skos:prefLabel "Actions typically used in an ODRL Permission"@en .

<https://odrl.codata.org/cv1/collection/prohibitionActions> a skos:Collection ;
    skos:member cv1:analysisDeviceInstrument,
        cv1:credentialDisclosure,
        cv1:identifyAnIndividualHouseholdOrOrganisation,
        cv1:mutuallyExclusiveAnalysis,
        cv1:takeScreenShot ;
    skos:prefLabel "Actions typically used in an ODRL Prohibition"@en .

<https://odrl.codata.org/cv3/collection/deprecated> a skos:Collection ;
    skos:member cv3:absolutePosition,
        cv3:absoluteSize,
        cv3:absoluteSpatialPosition,
        cv3:absoluteTemporalPosition,
        cv3:device,
        cv3:system ;
    skos:prefLabel "Left operands not to be used in CDIF"@en .

<https://odrl.codata.org/cv3/collection/leftOperands> a skos:Collection ;
    skos:member cv3:absolutePosition,
        cv3:absoluteSize,
        cv3:absoluteSpatialPosition,
        cv3:absoluteTemporalPosition,
        cv3:aiSystem,
        cv3:count,
        cv3:data,
        cv3:dataController,
        cv3:dataProcessor,
        cv3:dataSource,
        cv3:dataSubject,
        cv3:dateTime,
        cv3:delayPeriod,
        cv3:deliveryChannel,
        cv3:device,
        cv3:dpvPurpose,
        cv3:dpvRecipient,
        cv3:duration,
        cv3:elapsedTime,
        cv3:entity,
        cv3:event,
        cv3:fileFormat,
        cv3:frequency,
        cv3:humanSubject,
        cv3:industry,
        cv3:justification,
        cv3:language,
        cv3:law,
        cv3:legalBasis,
        cv3:legalMeasure,
        cv3:location,
        cv3:media,
        cv3:meteredTime,
        cv3:model,
        cv3:organisationalMeasure,
        cv3:payAmount,
        cv3:percentage,
        cv3:personalData,
        cv3:physicalMeasure,
        cv3:product,
        cv3:purpose,
        cv3:recipient,
        cv3:resolution,
        cv3:right,
        cv3:risk,
        cv3:spatial,
        cv3:spatialCoordinates,
        cv3:system,
        cv3:systemDevice,
        cv3:technicalMeasure,
        cv3:technicalOrganisationalMeasure,
        cv3:technology,
        cv3:timeInterval,
        cv3:unitOfCount,
        cv3:version,
        cv3:virtualLocation ;
    skos:prefLabel "ODRL left operands used in CDIF"@en .

<https://odrl.codata.org/cv3/collection/noKnownUseCase> a skos:Collection ;
    skos:member cv3:media,
        cv3:product ;
    skos:prefLabel "Left operands without a known UKDS/Sikt use case"@en .

<https://odrl.codata.org/cv3/collection/restrictionCategories> a skos:Collection ;
    skos:member cv3:AddNewConstraintsBelowThisLineToBeValidated,
        cv3:EnvironmentalConstraints,
        cv3:FinancialConstraints,
        cv3:IdentityAndAccessConstraints,
        cv3:LegalAndRegulatoryConstraints,
        cv3:PersonConstraints,
        cv3:RoleConstraints,
        cv3:UsageContextConstraints ;
    skos:prefLabel "Restriction categories (under investigation)"@en .

cv2:AcademicResearch a skos:Concept ;
    skos:broader cv2:ResearchAndDevelopment ;
    skos:definition "Purposes associated with conducting or assisting with research conducted in an academic context e.g. within universities"@en ;
    skos:exactMatch dpv:AcademicResearch ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "AcademicResearch"@en .

cv2:AccountManagement a skos:Concept ;
    skos:broader cv2:ServiceProvision ;
    skos:definition "Account Management refers to purposes associated with account management, such as to create, provide, maintain, and manage accounts"@en ;
    skos:exactMatch dpv:AccountManagement ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "AccountManagement"@en .

cv2:AddNewPurposesBelowThisLineToBeValidated a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:AddNewPurposesBelowThisLineToBeValidated ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Add New purposes below this line - to be validated"@en .

cv2:Advertising a skos:Concept ;
    skos:broader cv2:Marketing ;
    skos:definition "Purposes associated with conducting advertising i.e. process or artefact used to call attention to a product, service, etc. through announcements, notices, or other forms of communication"@en ;
    skos:exactMatch dpv:Advertising ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Advertising"@en .

cv2:CommunicationManagement a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:definition "Communication Management refers to purposes associated with providing or managing communication activities e.g. to send an email for notifying some information"@en ;
    skos:exactMatch dpv:CommunicationManagement ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "CommunicationManagement"@en .

cv2:CustomerManagement a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:definition "Customer Management refers to purposes associated with managing activities related with past, current, and future customers"@en ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:CustomerManagement ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "CustomerManagement"@en .

cv2:Education a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:Education ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Education"@en .

cv2:EnforceSecurity a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:definition "Purposes associated with ensuring and enforcing security for data, personnel, or other related matters"@en ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:EnforceSecurity ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "EnforceSecurity"@en .

cv2:HumanResourceManagement a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:definition "Purposes associated with managing humans and 'human resources' within the organisation for effective and efficient operations."@en ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:HumanResourceManagement ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "HumanResourceManagement"@en .

cv2:OrganisationGovernance a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:OrganisationGovernance ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "OrganisationGovernance"@en .

cv2:Outreach a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:Outreach ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Outreach"@en .

cv2:Personalisation a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:Personalisation ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Personalisation"@en .

cv2:Promotional a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:Promotional ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Promotional"@en .

cv2:PublicBenefit a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:PublicBenefit ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "PublicBenefit"@en .

cv2:RecordManagement a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:RecordManagement ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "RecordManagement"@en .

cv2:ScientificResearch a skos:Concept ;
    skos:broader cv2:ResearchAndDevelopment ;
    skos:definition "Purposes associated with scientific research"@en ;
    skos:exactMatch dpv:ScientificResearch ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Scientific Research"@en .

cv2:Teaching a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:Teaching ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Teaching"@en .

cv2:Training a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:Training ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Training"@en .

cv2:VendorManagement a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:VendorManagement ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "VendorManagement"@en .

cv4:anonymise a skos:Concept ;
    skos:exactMatch odrl:anonymize,
        cv1:anonymise ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "anonymise"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:authenticate a skos:Concept ;
    skos:definition "Use an accepted authentication method to prove the identity"@en ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "Authenticate"@en ;
    skos:scopeNote "The set of accepted authentication methods will depend on the requirements of the asset owner and the possible constraints imposed by the nature of the asset (e.g. multi-factor authentication required for clinical data). The authentication process should allow verifying membership in project teams, organisations and groups of users holding specific rights based on their role [C.f. odrl:Party?]."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:compensation a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "Compensation"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:completeRegistration a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "CompleteRegistration"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:designateResponsiblePerson a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "designateResponsiblePerson"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:getEthicsApproval a skos:Concept ;
    skos:definition "Any action on the asset requires a proof of ethics approval"@en ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "GetEthicsApproval"@en ;
    skos:scopeNote "Performing the action on the asset needs to be linked to an ethics approval using methods that fulfill the relevant legal and governance requirements that are relevant to the asset and the legal entity controlling the access to the asset. [typically the ethics approval is reviewed by the asset controller and linked to the user's account? C.f. odrl:reviewPolicy?]"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:obtainCompletedAgreement a skos:Concept ;
    skos:definition "The action requires an agreement with all involved parties"@en ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:note "e,g, EUL (refinement will specify what form, what signature type etc.)"@en ;
    skos:prefLabel "ObtainCompletedAgreement"@en ;
    skos:scopeNote "The action on an asset requires verifiable consent of all relevant stakeholders, e.g. signature of an End User Agreement or agreements needed for secure transfer of data into a trusted research environment."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:payment a skos:Concept ;
    skos:definition "Any action on the asset requires a payment"@en ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "Payment"@en ;
    skos:scopeNote "Performing an action on the asset requires a fee and a commitment to pay linked to the access request. The legal entity controlling the access determines the modalities of acceptable payment modalities (e.g. proof of payment required before the access, post-access invoicing or using credits assigned to the project or organisation the requesting party belongs to)."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:provisionSecureEnvironment a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "provisionSecureEnvironment"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:pseudonymise a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "pseudonymise"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:thirdPartyAuthorization a skos:Concept ;
    skos:definition "The action on an asset requires an additional authorisation from a third party"@en ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:note "e.g. GetApproval from DataOwner"@en ;
    skos:prefLabel "ThirdPartyAuthorization"@en ;
    skos:scopeNote "The action on an asset requires an authorisation from a third party (or third parties); for example, GetApproval from the data owner [c.f. odrl:obtainConsent? GetApproval hanging reference?]"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:verifyAccreditation a skos:Concept ;
    skos:definition "The action requires verification of accreditation"@en ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "VerifyAccreditation"@en ;
    skos:scopeNote "Performing the action on the asset requires verification of an accreditation (certification, membership in a skills- or competence-based organisation or professional body)."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:verifyProjectContext a skos:Concept ;
    skos:definition "The action requires verification of the project"@en ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:note "Submit a project description or research protocol"@en ;
    skos:prefLabel "VerifyProjectContext"@en ;
    skos:scopeNote "The action requires review of the project context, e.g. analysis of the project description or research protocol. Typically this will create a new role or set of roles that can be used in the authentication context"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:verifyTraining a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "VerifyTraining"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv1:acceptTracking a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-acceptTracking> ;
    skos:exactMatch odrl:acceptTracking ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "AcceptTracking"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:adHocSharing a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-adHocShare> ;
    owl:deprecated true ;
    skos:exactMatch odrl:adHocShare ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Deprecated, \"The act of sharing the asset to parties in close proximity to the owner\""@en ;
    skos:prefLabel "Ad-hoc sharing"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:aggregate a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-Aggregate> ;
    skos:exactMatch odrl:aggregate ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "aggregate"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:aiAnalysis a skos:Concept ;
    skos:definition "The asset can be analysed using AI"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "AI-analysis"@en ;
    skos:scopeNote "An AI tool can be used to analyse the data, but not to modify it. There is a risk of information of the assets becoming embedded in an AI model that is a result of this action."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:aiCuration a skos:Concept ;
    skos:definition "The asset or its metadata can be curated using AI"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "AI-curation"@en ;
    skos:scopeNote "An AI tool can be used to analyse, refine and modify the asset or its metadata. There is a risk of unintended consequences (within the subset of the authorised actions of the user), as well as the information of the assets becoming embedded in an AI model that is a result of this action. Assumes authorisation to actions such as Read or writeTo that can be delegated to an AI solution."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:aiSearch a skos:Concept ;
    skos:definition "The asset or its metadata can be searched using AI"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "cf. https://w3c.github.io/odrl/ai-vocab/#ai"@en ;
    skos:prefLabel "AI-search"@en ;
    skos:scopeNote "An AI tool can be used to search data, typially in combination of diplay, derive or extract actions. The data asset or its medatadata will not be modified. There is a risk of information of the assets becoming embedded in an AI model that is a result of this action."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:annotate a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-Annotate> ;
    skos:exactMatch odrl:annotate ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "annotate"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:apiAccess a skos:Concept ;
    skos:definition "The asset can be accessed through an API"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "API access"@en ;
    skos:scopeNote "It is possible to access the asset using a programmable interface. The access method is not exclusive by default, i.e. it is possible to authorise other access actions for the asset (e.g. read, download,..)"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:append a skos:Concept ;
    dct:isReplacedBy cv1:modify ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-append> ;
    owl:deprecated true ;
    skos:exactMatch odrl:append ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "deprecated by http://www.w3.org/ns/odrl/2/modify"@en ;
    skos:prefLabel "append"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:archive a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-archive> ;
    skos:exactMatch odrl:archive ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "archive"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:browse a skos:Concept ;
    skos:editorialNote "Synonym for ODRL:Play?"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "Browse"@en ;
    skos:scopeNote "ODRL play: To create a sequential and transient rendition of an Asset.\", with a subcategory \"display\" for static content"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:concurrentUse a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-concurrentUse> ;
    skos:exactMatch odrl:concurrentUse ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
