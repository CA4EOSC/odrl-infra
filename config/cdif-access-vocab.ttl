cv2:CommercialPurpose a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:definition "Purposes associated with processing activities performed in a commercial setting or with intention to commercialise"@en ;
    skos:exactMatch dpv:CommercialPurpose ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:narrower cv2:CommercialResearch ;
    skos:prefLabel "CommercialPurpose"@en .

cv2:CommercialResearch a skos:Concept ;
    skos:broader cv2:CommercialPurpose,
        cv2:ResearchAndDevelopment ;
    skos:definition "Purposes associated with conducting research in a commercial setting or with intention to commercialise e.g. in a company or sponsored by a company"@en ;
    skos:exactMatch dpv:CommercialResearch ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Commercial Research"@en .

cv2:Marketing a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:definition "Purposes associated with marketing, advertising, and promotional activities."@en ;
    skos:exactMatch dpv:Marketing ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:narrower cv2:Advertising ;
    skos:prefLabel "Marketing"@en .

cv2:NonCommercialPurpose a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:definition "Purposes associated with processing activities performed in a non-commercial setting or without intention to commercialise"@en ;
    skos:editorialNote "Parent not given in source sheet; set to Purpose following the DPV hierarchy."@en ;
    skos:exactMatch dpv:NonCommercialPurpose ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:narrower cv2:NonCommercialResearch ;
    skos:prefLabel "NonCommercialPurpose"@en .

cv2:NonCommercialResearch a skos:Concept ;
    skos:broader cv2:NonCommercialPurpose,
        cv2:ResearchAndDevelopment ;
    skos:definition "Purposes associated with conducting research in a non-commercial setting e.g. for a non-profit-organisation (NGO)"@en ;
    skos:exactMatch dpv:NonCommercialResearch ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:prefLabel "Non-Commercial Research"@en .

cv2:ServiceProvision a skos:Concept ;
    skos:broader cv2:Purpose ;
    skos:definition "Purposes associated with the provision of a service or product."@en ;
    skos:exactMatch dpv:ServiceProvision ;
    skos:inScheme <https://odrl.codata.org/cv2> ;
    skos:narrower cv2:AccountManagement ;
    skos:prefLabel "ServiceProvision"@en .

