    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:signAcceptAgreement a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty (generalised, as refinement would specify specific form for example)"@en ;
    skos:prefLabel "Sign/AcceptAgreement"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:storeData a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Permission with common geospatial, temporal and environmental constraints"@en ;
    skos:prefLabel "StoreData"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:submitAnalysisOutputsForChecking a skos:Concept ;
