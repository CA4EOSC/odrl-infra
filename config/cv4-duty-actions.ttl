@prefix cv1: <https://odrl.codata.org/cv1/> .
@prefix cv4: <https://odrl.codata.org/cv4/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cv4:anonymise a skos:Concept ;
    skos:exactMatch odrl:anonymize,
        cv1:anonymise ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "anonymise"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:authenticate a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "Authenticate"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:compensation a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "Compensation"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:completeRegistration a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "CompleteRegistration"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:designateResponsiblePerson a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "designateResponsiblePerson"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:getEthicsApproval a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "GetEthicsApproval"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:obtainCompletedAgreement a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "ObtainCompletedAgreement"@en ;
    skos:scopeNote "e,g, EUL (refinement will specify what form, what signature type etc.)"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:payment a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "Payment"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:provisionSecureEnvironment a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "provisionSecureEnvironment"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:pseudonymise a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "pseudonymise"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:thirdPartyAuthorization a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "ThirdPartyAuthorization"@en ;
    skos:scopeNote "e.g. GetApproval from DataOwner"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:verifyAccreditation a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "VerifyAccreditation"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:verifyProjectContext a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "VerifyProjectContext"@en ;
    skos:scopeNote "Submit a project description or research protocol"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

cv4:verifyTraining a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv4> ;
    skos:prefLabel "VerifyTraining"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv4> .

<https://odrl.codata.org/cv4> a skos:ConceptScheme ;
    dct:created "2026-11-04"^^xsd:date ;
    dct:description "Actions that an assignee must perform (ODRL duties) before or while exercising a permission in a CDIF access policy."@en ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-Duty> ;
    dct:title "CDIF Duty Actions (CV4)"@en ;
    skos:hasTopConcept cv4:anonymise,
        cv4:authenticate,
        cv4:compensation,
        cv4:completeRegistration,
        cv4:designateResponsiblePerson,
        cv4:getEthicsApproval,
        cv4:obtainCompletedAgreement,
        cv4:payment,
        cv4:provisionSecureEnvironment,
        cv4:pseudonymise,
        cv4:thirdPartyAuthorization,
        cv4:verifyAccreditation,
        cv4:verifyProjectContext,
        cv4:verifyTraining .

