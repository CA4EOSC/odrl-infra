    rdfs:isDefinedBy <https://w3id.org/cdif/access> ;
    skos:inScheme <https://w3id.org/cdif/access/cv4> ;
    skos:prefLabel "Obtain Completed Agreement"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/cv4> .

cdif-access:ProvideSecureEnvironment a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/cdif/access> ;
    skos:inScheme <https://w3id.org/cdif/access/cv4> ;
    skos:prefLabel "Provide Secure Environment"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/cv4> .

cdif-access:Pseudonymise a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/cdif/access> ;
    skos:inScheme <https://w3id.org/cdif/access/cv4> ;
