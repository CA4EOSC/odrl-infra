    skos:prefLabel "Verify Training"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/cv4> .

<https://w3id.org/cdif/access/cv4> a skos:ConceptScheme ;
    dcterms:description "Duty actions of the CDIF access profile (cdif-access:actionsCollection, '# duty actions')."@en ;
    dcterms:source <https://w3id.org/cdif/access> ;
    skos:prefLabel "CDIF Duty Actions (CV4)"@en .

