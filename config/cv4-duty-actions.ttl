@prefix cdif-access: <https://w3id.org/cdif/access#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/cdif/access/collection/cdif-specific-actions> a skos:Collection ;
    skos:member cdif-access:Authenticate,
        cdif-access:CompleteRegistration,
        cdif-access:DesignateResponsiblePerson,
        cdif-access:GetEthicsApproval,
        cdif-access:ObtainCompletedAgreement,
        cdif-access:ProvideSecureEnvironment,
        cdif-access:Pseudonymise,
        cdif-access:ThirdPartyAuthorization,
        cdif-access:VerifyAccreditation,
        cdif-access:VerifyProjectContext,
        cdif-access:VerifyTraining ;
    skos:prefLabel "CDIF-specific actions"@en .

<https://w3id.org/cdif/access/collection/odrl-common-vocabulary> a skos:Collection ;
    skos:member odrl:compensate ;
    skos:prefLabel "ODRL Common Vocabulary"@en .

odrl:compensate a skos:Concept ;
    rdfs:isDefinedBy odrl: ;
    skos:definition "To compensate by transfer of some amount of value, if defined, for using or selling the Asset."@en ;
    skos:editorialNote "I don't think you need Payment as an action, ODRL already has odrl:compensate"@en ;
    skos:inScheme <https://w3id.org/cdif/access/cv4> ;
    skos:note "The compensation may use different types of things with a value: (i) the thing is expressed by the value (term) of the Constraint name; (b) the value is expressed by operator, rightOperand, dataType and unit. Typically the assignee will compensate the assigner, but other compensation party roles may be used."@en ;
    skos:prefLabel "Compensate"@en ;
    skos:scopeNote "Non-Normative"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/cv4> .

cdif-access:Authenticate a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/cdif/access> ;
    skos:inScheme <https://w3id.org/cdif/access/cv4> ;
    skos:prefLabel "Authenticate"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/cv4> .

cdif-access:CompleteRegistration a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/cdif/access> ;
    skos:inScheme <https://w3id.org/cdif/access/cv4> ;
    skos:prefLabel "Complete Registration"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/cv4> .

