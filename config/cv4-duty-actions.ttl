    skos:inScheme <https://w3id.org/cdif/access/cv4> ;
    skos:prefLabel "Third Party Authorization"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/cv4> .

cdif-access:VerifyAccreditation a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/cdif/access> ;
    skos:inScheme <https://w3id.org/cdif/access/cv4> ;
    skos:prefLabel "Verify Accreditation"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/cv4> .

cdif-access:VerifyProjectContext a skos:Concept ;
