cv1:aiAnalysis a skos:Concept ;
    skos:inScheme <https://w3id.org/cdif/access/action> ;
    skos:prefLabel "AI-analysis"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/action> .

cv1:aiCuration a skos:Concept ;
    skos:inScheme <https://w3id.org/cdif/access/action> ;
    skos:prefLabel "AI-curation"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/action> .

cv1:aiSearch a skos:Concept ;
    skos:inScheme <https://w3id.org/cdif/access/action> ;
    skos:prefLabel "AI-search"@en ;
    skos:scopeNote "cf. https://w3c.github.io/odrl/ai-vocab/#ai"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/action> .

cv1:annotate a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-Annotate> ;
    skos:exactMatch odrl:annotate ;
    skos:inScheme <https://w3id.org/cdif/access/action> ;
    skos:prefLabel "annotate"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/action> .

cv1:anonymise a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-anonymize> ;
    skos:exactMatch odrl:anonymize ;
    skos:inScheme <https://w3id.org/cdif/access/action> ;
    skos:prefLabel "anonymise"@en ;
    skos:scopeNote "Constraint? \"For example, to remove identifying particulars for statistical or for other comparable purposes, or to use the Asset without stating the author/source.\""@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/action> .

cv1:apiAccess a skos:Concept ;
    skos:inScheme <https://w3id.org/cdif/access/action> ;
