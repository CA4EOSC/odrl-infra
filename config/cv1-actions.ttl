        cv1:delete,
        cv1:depositDerivedDataProduct,
        cv1:derivativeWorks,
        cv1:derive,
        cv1:destroyData,
        cv1:digitize,
        cv1:display,
        cv1:distribute,
        cv1:distribution,
        cv1:download,
        cv1:encryptDataLocally,
        cv1:execute,
        cv1:export,
        cv1:extract,
        cv1:extractChar,
        cv1:extractPage,
        cv1:extractWord,
        cv1:give,
        cv1:grantUse,
        cv1:identifyAnIndividualHouseholdOrOrganisation,
        cv1:include,
        cv1:index,
        cv1:inform,
        cv1:install,
        cv1:linkToOtherData,
        cv1:modify,
        cv1:move,
        cv1:mutuallyExclusiveAnalysis,
        cv1:notify,
        cv1:onlineAnalysis,
        cv1:play,
        cv1:present,
        cv1:preview,
        cv1:print,
        cv1:procureThirdPartyApproval,
        cv1:reArchive,
        cv1:read,
        cv1:reproduce,
        cv1:reproduction,
        cv1:republish,
        cv1:reshare,
        cv1:reviewPolicy,
        cv1:searchInTheContent,
        cv1:secondaryUse,
        cv1:secureTransfer,
        cv1:sell,
        cv1:share,
        cv1:signAcceptAgreement,
        cv1:storeData,
        cv1:stream,
        cv1:submitAnalysisOutputsForChecking,
        cv1:synchronize,
        cv1:takeScreenShot,
        cv1:textToSpeech,
        cv1:transform,
        cv1:translate,
        cv1:view,
        cv1:watermark,
        cv1:write,
        cv1:writeTo .

