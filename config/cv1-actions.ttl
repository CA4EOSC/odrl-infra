    dct:source <https://www.w3.org/TR/odrl-vocab/#term-read> ;
    skos:exactMatch odrl:read ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "Read"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:reproduction a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-Reproduction> ;
    skos:exactMatch cc:Reproduction ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "do you really need this one given that there is odrl:reproduce?"@en ;
    skos:prefLabel "Reproduction"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:republish a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "Republish"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:reshare a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "Reshare"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:reviewPolicy a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-reviewPolicy> ;
    skos:exactMatch odrl:reviewPolicy ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Escalation step to bring a human into the loop"@en ;
    skos:prefLabel "Review Policy"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:searchInTheContent a skos:Concept ;
