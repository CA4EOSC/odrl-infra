@prefix cc: <http://creativecommons.org/ns#> .
@prefix cv1: <https://w3id.org/cdif/access/action/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/cdif/access/action/collection/cdifExtension> a skos:Collection ;
    skos:member cv1:acceptTermsOfUse,
        cv1:accreditedTrainingCompleted,
        cv1:aiAnalysis,
        cv1:aiCuration,
        cv1:aiSearch,
        cv1:analysisDeviceInstrument,
        cv1:apiAccess,
        cv1:associateWithResearchProject,
        cv1:browse,
        cv1:citeData,
        cv1:completeUserRegistration,
        cv1:credentialDisclosure,
        cv1:depositDerivedDataProduct,
        cv1:destroyData,
        cv1:download,
        cv1:encryptDataLocally,
        cv1:extractWord,
        cv1:identifyAnIndividualHouseholdOrOrganisation,
        cv1:linkToOtherData,
        cv1:modify,
        cv1:mutuallyExclusiveAnalysis,
        cv1:notify,
        cv1:onlineAnalysis,
        cv1:procureThirdPartyApproval,
        cv1:reArchive,
        cv1:republish,
        cv1:reshare,
        cv1:searchInTheContent,
        cv1:secondaryUse,
        cv1:secureTransfer,
        cv1:share,
        cv1:signAcceptAgreement,
        cv1:storeData,
        cv1:submitAnalysisOutputsForChecking,
        cv1:takeScreenShot,
        cv1:verifyResearchEnvironment,
        cv1:view ;
    skos:prefLabel "CDIF-specific actions"@en .

<https://w3id.org/cdif/access/action/collection/dutyActions> a skos:Collection ;
    skos:member cv1:acceptTermsOfUse,
        cv1:accreditedTrainingCompleted,
        cv1:analysisDeviceInstrument,
        cv1:associateWithResearchProject,
        cv1:citeData,
        cv1:completeUserRegistration,
        cv1:depositDerivedDataProduct,
        cv1:destroyData,
        cv1:encryptDataLocally,
        cv1:notify,
        cv1:procureThirdPartyApproval,
        cv1:signAcceptAgreement,
        cv1:submitAnalysisOutputsForChecking,
        cv1:verifyResearchEnvironment ;
    skos:prefLabel "Actions typically used in an ODRL Duty"@en .

<https://w3id.org/cdif/access/action/collection/odrlCommon> a skos:Collection ;
    skos:member cv1:acceptTracking,
        cv1:adHocSharing,
        cv1:aggregate,
        cv1:annotate,
        cv1:anonymise,
        cv1:append,
        cv1:archive,
        cv1:concurrentUse,
        cv1:copy,
        cv1:delete,
        cv1:derivativeWorks,
        cv1:derive,
        cv1:digitize,
        cv1:display,
        cv1:distribute,
        cv1:distribution,
        cv1:execute,
        cv1:export,
        cv1:extract,
        cv1:extractChar,
        cv1:extractPage,
        cv1:give,
        cv1:grantUse,
        cv1:include,
        cv1:index,
        cv1:inform,
        cv1:install,
        cv1:move,
        cv1:play,
        cv1:present,
        cv1:preview,
        cv1:print,
        cv1:read,
        cv1:reproduce,
        cv1:reproduction,
        cv1:reviewPolicy,
        cv1:sell,
        cv1:stream,
        cv1:synchronize,
        cv1:textToSpeech,
        cv1:transform,
        cv1:translate,
        cv1:watermark,
        cv1:write,
        cv1:writeTo ;
    skos:prefLabel "Actions from the ODRL Common Vocabulary"@en .

<https://w3id.org/cdif/access/action/collection/permissionActions> a skos:Collection ;
    skos:member cv1:storeData ;
    skos:prefLabel "Actions typically used in an ODRL Permission"@en .

<https://w3id.org/cdif/access/action/collection/prohibitionActions> a skos:Collection ;
    skos:member cv1:analysisDeviceInstrument,
        cv1:credentialDisclosure,
        cv1:identifyAnIndividualHouseholdOrOrganisation,
        cv1:mutuallyExclusiveAnalysis,
        cv1:takeScreenShot ;
    skos:prefLabel "Actions typically used in an ODRL Prohibition"@en .

cv1:acceptTracking a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-acceptTracking> ;
    skos:exactMatch odrl:acceptTracking ;
    skos:inScheme <https://w3id.org/cdif/access/action> ;
    skos:prefLabel "AcceptTracking"@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/action> .

cv1:adHocSharing a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-adHocShare> ;
    owl:deprecated true ;
    skos:exactMatch odrl:adHocShare ;
    skos:inScheme <https://w3id.org/cdif/access/action> ;
    skos:prefLabel "Ad-hoc sharing"@en ;
    skos:scopeNote "Deprecated, \"The act of sharing the asset to parties in close proximity to the owner\""@en ;
    skos:topConceptOf <https://w3id.org/cdif/access/action> .

cv1:aggregate a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-Aggregate> ;
