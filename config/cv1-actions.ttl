cv1:secondaryUse a skos:Concept ;
    owl:deprecated true ;
    skos:editorialNote "Mapping to ODRL added during SKOS conversion; not stated in source sheet."@en ;
    skos:exactMatch odrl:secondaryUse ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "The act of using the asset for a purpose other than the purpose it was intended for, deprecated"@en ;
    skos:prefLabel "secondaryUse"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:secureTransfer a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "Secure Transfer"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:sell a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-sell> ;
    skos:exactMatch odrl:sell ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "N.B. Assumes the asset is deleted after the sale"@en ;
    skos:prefLabel "Sell"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:share a skos:Concept ;
    skos:editorialNote "Mapping to ODRL added during SKOS conversion; not stated in source sheet."@en ;
    skos:exactMatch odrl:share ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Decprecated? Explanation \"The act of the non-commercial reproduction and distribution of the asset to third-parties\" from https://www.w3.org/ns/odrl/2/ODRL22.ttl"@en ;
    skos:prefLabel "Share"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:stream a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-stream> ;
    skos:exactMatch odrl:stream ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "Stream"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:synchronize a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-synchronize> ;
    skos:exactMatch odrl:synchronize ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "Synchronize"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:textToSpeech a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-textToSpeech> ;
    skos:exactMatch odrl:textToSpeech ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Subcategory of use instead of \"Transform\"; exemption for accessibility probably applies, too"@en ;
    skos:prefLabel "Text-to-speech"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:translate a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-translate> ;
    skos:exactMatch odrl:translate ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "N.B. translation of copyright-protected material requires permission (even for internal use in an organisation)."@en ;
    skos:prefLabel "Translate"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:view a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:prefLabel "View"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:watermark a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-watermark> ;
    skos:exactMatch odrl:watermark ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Works directly on the asset? Does not seem to have semantics WRT accessiblity of the original (should not be made accessible, must be made accessible to the owner,...?)"@en ;
    skos:prefLabel "Watermark"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:write a skos:Concept ;
    dct:isReplacedBy cv1:modify ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-write> ;
    owl:deprecated true ;
    skos:exactMatch odrl:write ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "deprecated by https://www.w3.org/ns/odrl/2/modify"@en ;
    skos:prefLabel "Write"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:writeTo a skos:Concept ;
    dct:isReplacedBy cv1:modify ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-writeTo> ;
    owl:deprecated true ;
    skos:exactMatch odrl:writeTo ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "deprecated by https://www.w3.org/ns/odrl/2/modify"@en ;
    skos:prefLabel "writeTo"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:accreditedTrainingCompleted a skos:Concept ;
    skos:definition "Before performing an action on an asset the user must have completed relevant, accredited training"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty"@en ;
    skos:prefLabel "AccreditedTrainingCompleted"@en ;
    skos:scopeNote "The action to be performed on the asset is authorised only for persons who have received appropriate and sufficient training. The training needs can refer to certification frameworks and certificates or proof of completion of a specific course. [how would you define acceptable values for this? Or is this boolean, with the actual test performed elsewhere?]"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:associateWithResearchProject a skos:Concept ;
    skos:definition "The access to the resource is limited to specific research projects"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty"@en ;
    skos:prefLabel "AssociateWithResearchProject"@en ;
    skos:scopeNote "The user or agent will be granted access to the agent only if the credetials are associated to specific research projects"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:citeData a skos:Concept ;
    skos:definition "If the asset is used in the project context, the relevant project outputs need to cite the dataset"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty during project"@en ;
    skos:prefLabel "CiteData"@en ;
    skos:scopeNote "The project outputs need to cite the dataset in outputs (e.g. papers, derived datasets,...) where it can be reasonably argued that the dataset has contributed to the generation of new intellectual property."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:credentialDisclosure a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Prohibition (must not share password)"@en ;
    skos:prefLabel "CredentialDisclosure"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:depositDerivedDataProduct a skos:Concept ;
    skos:definition "Derived data products need to be deposited in a repository"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty"@en ;
    skos:prefLabel "DepositDerivedDataProduct"@en ;
    skos:scopeNote "The derived data products (datasets, publications,...) need to be curated and preserved by depositing them in a repository [do we want to qualify repository? \"A repository with known operational practices and sustainability plans? Do we want to state that the metadata should be accessible to the original authors?]"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:destroyData a skos:Concept ;
    skos:definition "Any copies or extracted parts of the data assets need to be destroyed after the end of the project"@en ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty at end of project"@en ;
    skos:prefLabel "DestroyData"@en ;
    skos:scopeNote "The user needs to commit to deletion of all full or partial copies of the original data asset after the end of the project in a way that fully erases information contained in them. The deletion needs to be completed as soon as technically possible and take into account on- and offline backups on network-accessible or removable media as well as printed copies of the datasets."@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:encryptDataLocally a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty e.g. must encrypt data on local device"@en ;
    skos:prefLabel "EncryptDataLocally"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:identifyAnIndividualHouseholdOrOrganisation a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Prohibition"@en ;
    skos:prefLabel "Identify an individual, household or organisation"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:mutuallyExclusiveAnalysis a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Prohibition (e.g. can analyse dataset x but not in conjunction with dataset y)"@en ;
    skos:prefLabel "MutuallyExclusiveAnalysis"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:notify a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty e.g. of non-compliance or breach"@en ;
    skos:prefLabel "Notify"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:procureThirdPartyApproval a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty (refinement specifies who and payload)"@en ;
    skos:prefLabel "ProcureThirdPartyApproval"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:reproduce a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-reproduce> ;
    skos:exactMatch odrl:reproduce ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "\"ND\" semantics, compared to derive or extract"@en ;
    skos:prefLabel "Reproduce"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:signAcceptAgreement a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty (generalised, as refinement would specify specific form for example)"@en ;
    skos:prefLabel "Sign/AcceptAgreement"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:storeData a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Permission with common geospatial, temporal and environmental constraints"@en ;
    skos:prefLabel "StoreData"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:submitAnalysisOutputsForChecking a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty"@en ;
    skos:prefLabel "SubmitAnalysisOutputsForChecking"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:takeScreenShot a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Prohibition"@en ;
    skos:prefLabel "TakeScreenShot"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:transform a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-transform> ;
    skos:exactMatch odrl:transform ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Format conversion, N.B. usually legal without permission for accessibiltiy purposes (equal access to a resource)"@en ;
    skos:prefLabel "Transform"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:analysisDeviceInstrument a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "Duty/Prohibition (q. for Beatriz - is whitelist or blacklist approach better)"@en ;
    skos:prefLabel "AnalysisDevice/Instrument"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

cv1:modify a skos:Concept ;
    skos:editorialNote "Mapping to ODRL added during SKOS conversion; not stated in source sheet."@en ;
    skos:exactMatch odrl:modify ;
    skos:inScheme <https://odrl.codata.org/cv1> ;
    skos:note "C.f. derive and extract; versioning semantics?"@en ;
    skos:prefLabel "Modify"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv1> .

<https://odrl.codata.org/cv1> a skos:ConceptScheme ;
    dct:created "2026-11-04"^^xsd:date ;
    dct:description "Actions that can be permitted, prohibited or required (duties) in CDIF access policies. Re-uses the ODRL Common Vocabulary where possible."@en ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#actionsCommon> ;
    dct:title "CDIF Actions (CV1)"@en ;
    skos:hasTopConcept cv1:acceptTracking,
        cv1:accreditedTrainingCompleted,
        cv1:adHocSharing,
        cv1:aggregate,
        cv1:aiAnalysis,
