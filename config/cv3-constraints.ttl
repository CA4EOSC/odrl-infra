<https://odrl.codata.org/cv3> a skos:ConceptScheme ;
    dct:created "2026-11-04"^^xsd:date ;
    dct:description "Other constraints describing the scope of applicability of a CDIF access policy: the ODRL left operands selected for CDIF, and broader restriction categories (environment, legal, usage context, person, identity, role, financial) still under investigation."@en ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-LeftOperand> ;
    dct:title "CDIF Other Constraints (CV3)"@en ;
    skos:hasTopConcept cv3:AddNewConstraintsBelowThisLineToBeValidated,
