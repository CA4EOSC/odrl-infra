    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:Justification"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:language a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-language> ;
    skos:exactMatch odrl:language ;
    skos:example "language eq de"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "language"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:law a skos:Concept ;
    skos:closeMatch dpv:Law ;
