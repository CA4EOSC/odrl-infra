@prefix cv3: <https://odrl.codata.org/cv3/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://odrl.codata.org/cv3/collection/deprecated> a skos:Collection ;
    skos:member cv3:absolutePosition,
        cv3:absoluteSize,
        cv3:absoluteSpatialPosition,
        cv3:absoluteTemporalPosition,
        cv3:device,
        cv3:system ;
    skos:prefLabel "Left operands not to be used in CDIF"@en .

<https://odrl.codata.org/cv3/collection/leftOperands> a skos:Collection ;
    skos:member cv3:absolutePosition,
        cv3:absoluteSize,
        cv3:absoluteSpatialPosition,
        cv3:absoluteTemporalPosition,
        cv3:aiSystem,
        cv3:count,
        cv3:data,
        cv3:dataController,
        cv3:dataProcessor,
        cv3:dataSource,
        cv3:dataSubject,
        cv3:dateTime,
        cv3:delayPeriod,
        cv3:deliveryChannel,
        cv3:device,
        cv3:dpvPurpose,
        cv3:dpvRecipient,
        cv3:duration,
        cv3:elapsedTime,
        cv3:entity,
        cv3:event,
        cv3:fileFormat,
        cv3:frequency,
        cv3:humanSubject,
        cv3:industry,
        cv3:justification,
        cv3:language,
        cv3:law,
        cv3:legalBasis,
        cv3:legalMeasure,
        cv3:location,
        cv3:media,
        cv3:meteredTime,
        cv3:model,
        cv3:organisationalMeasure,
        cv3:payAmount,
        cv3:percentage,
        cv3:personalData,
        cv3:physicalMeasure,
        cv3:product,
        cv3:purpose,
        cv3:recipient,
        cv3:resolution,
        cv3:right,
        cv3:risk,
        cv3:spatial,
        cv3:spatialCoordinates,
        cv3:system,
        cv3:systemDevice,
        cv3:technicalMeasure,
        cv3:technicalOrganisationalMeasure,
        cv3:technology,
        cv3:timeInterval,
        cv3:unitOfCount,
        cv3:version,
        cv3:virtualLocation ;
    skos:prefLabel "ODRL left operands used in CDIF"@en .

<https://odrl.codata.org/cv3/collection/noKnownUseCase> a skos:Collection ;
    skos:member cv3:media,
        cv3:product ;
    skos:prefLabel "Left operands without a known UKDS/Sikt use case"@en .

<https://odrl.codata.org/cv3/collection/restrictionCategories> a skos:Collection ;
    skos:member cv3:AddNewConstraintsBelowThisLineToBeValidated,
        cv3:EnvironmentalConstraints,
        cv3:FinancialConstraints,
        cv3:IdentityAndAccessConstraints,
        cv3:LegalAndRegulatoryConstraints,
        cv3:PersonConstraints,
        cv3:RoleConstraints,
        cv3:UsageContextConstraints ;
    skos:prefLabel "Restriction categories (under investigation)"@en .

cv3:AddNewConstraintsBelowThisLineToBeValidated a skos:Concept ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "Add New Constraints below this line - to be validated"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:EnvironmentalConstraints a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "EnvironmentalConstraints"@en ;
    skos:scopeNote "Characteristics of ReUse Environment e.g. TRE (cf. \"Safe Settings\""@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:FinancialConstraints a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "FinancialConstraints"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:IdentityAndAccessConstraints a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "IdentityAndAccessConstraints"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:LegalAndRegulatoryConstraints a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "LegalAndRegulatoryConstraints"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:PersonConstraints a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "PersonConstraints"@en ;
    skos:scopeNote "e.g. Training Status (this implies a Duty Action of \"Complete Training\" - although not formally modelled"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:RoleConstraints a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "RoleConstraints"@en ;
    skos:scopeNote "How to handle multiple role context of a single agent (could be Individual or Organisation, or machine)"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:UsageContextConstraints a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options (purpose plus other context like \"Research Project\""@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "UsageContextConstraints"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:aiSystem a skos:Concept ;
    skos:closeMatch <https://w3id.org/dpv/ai#AISystem> ;
    skos:editorialNote "Source sheet names 'ai:AISystem'; mapped during SKOS conversion."@en ;
    skos:example "ai:AISystem eq NameOfAISystem"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "ai:AISystem"@en ;
    skos:scopeNote "e.g. ai:AISystem eq \"Claude\""@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:count a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-count> ;
    skos:exactMatch odrl:count ;
    skos:example "count eq 1"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "count"@en ;
    skos:scopeNote "How many times you can download"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:data a skos:Concept ;
    skos:closeMatch dpv:Data ;
    skos:editorialNote "Source sheet names 'dpv:Data'; mapped during SKOS conversion."@en ;
    skos:example "dpv:Data eq UID"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:Data"@en ;
    skos:scopeNote "e.g. Data eq \"UKDS-SN12345\"; Data eq DOI"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:dataController a skos:Concept ;
    skos:closeMatch dpv:DataController ;
    skos:editorialNote "Source sheet names 'dpv:DataController'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:DataController"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:dataProcessor a skos:Concept ;
    skos:closeMatch dpv:DataProcessor ;
    skos:editorialNote "Source sheet names 'dpv:DataProcessor'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:DataProcessor"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:dataSource a skos:Concept ;
    skos:closeMatch dpv:DataSource ;
    skos:editorialNote "Source sheet names 'dpv:DataSource'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:DataSource"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:dataSubject a skos:Concept ;
    skos:closeMatch dpv:DataSubject ;
    skos:editorialNote "Source sheet names 'dpv:DataSubject'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:DataSubject"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:dateTime a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-dateTime> ;
    skos:exactMatch odrl:dateTime ;
    skos:example "dateTime eq 2026-11-04"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dateTime"@en ;
    skos:scopeNote "Multiple use cases"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:delayPeriod a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-delayPeriod> ;
    skos:exactMatch odrl:delayPeriod ;
    skos:example "delayPeriod eq 60 days"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "delayPeriod"@en ;
    skos:scopeNote "must wait a time period before action"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:deliveryChannel a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-deliveryChannel> ;
    skos:exactMatch odrl:deliveryChannel ;
    skos:example "deliveryChannel eq SafePod"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "deliveryChannel"@en ;
    skos:scopeNote "Data only access thr safepod network"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:dpvPurpose a skos:Concept ;
    skos:closeMatch dpv:Purpose ;
    skos:editorialNote "Marked 'SEE PURPOSE TAB' in source sheet."@en,
        "Source sheet names 'dpv:Purpose'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:Purpose"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:dpvRecipient a skos:Concept ;
    skos:closeMatch dpv:Recipient ;
    skos:editorialNote "Source sheet names 'dpv:Recipient'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:Recipient"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:duration a skos:Concept ;
    skos:closeMatch dpv:Duration ;
    skos:editorialNote "Source sheet names 'dpv:Duration'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:Duration"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:elapsedTime a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-elapsedTime> ;
    skos:exactMatch odrl:elapsedTime ;
    skos:example "elapsedTime eq 3 years"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "elapsedTime"@en ;
    skos:scopeNote "How long you can exercise the Action"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:entity a skos:Concept ;
    skos:closeMatch dpv:Entity ;
    skos:editorialNote "Source sheet names 'dpv:Entity'; mapped during SKOS conversion."@en ;
    skos:example "dpv:Entity eq \"EntityName\" or \"EntityCollection\""@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:Entity"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:event a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-event> ;
    skos:exactMatch odrl:event ;
    skos:example "event lt odrl:policyUsage"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "event"@en ;
    skos:scopeNote "Duty must be completed before the Action is exercised"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:fileFormat a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-fileFormat> ;
    skos:exactMatch odrl:fileFormat ;
    skos:example "fileFormat eq SPSS"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "fileFormat"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

