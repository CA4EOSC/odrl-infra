    skos:closeMatch dpv:Frequency ;
    skos:editorialNote "Source sheet names 'dpv:Frequency'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:Frequency"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:humanSubject a skos:Concept ;
    skos:closeMatch dpv:HumanSubject ;
