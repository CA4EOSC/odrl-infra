    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:Law"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:legalBasis a skos:Concept ;
    skos:closeMatch dpv:LegalBasis ;
    skos:editorialNote "Source sheet names 'dpv:LegalBasis'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:LegalBasis"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:legalMeasure a skos:Concept ;
    skos:closeMatch dpv:LegalMeasure ;
    skos:editorialNote "Source sheet names 'dpv:LegalMeasure'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:LegalMeasure"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:location a skos:Concept ;
    skos:altLabel "dpv:Location"@en ;
    skos:closeMatch dpv:Location ;
    skos:editorialNote "Source sheet names 'dpv:location' (DPV ODRL Profile); mapped during SKOS conversion."@en ;
    skos:example "dpv:location eq IRI"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:location"@en ;
    skos:scopeNote "Handle user is in UK jurisdictyion for example"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:meteredTime a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-meteredTime> ;
    skos:exactMatch odrl:meteredTime ;
    skos:example "meteredTime eq 100 hours"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "meteredTime"@en ;
    skos:scopeNote "non-contigiouus blocks of time"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:model a skos:Concept ;
    skos:closeMatch <https://w3id.org/dpv/ai#Model> ;
    skos:editorialNote "Source sheet names 'ai:Model'; mapped during SKOS conversion."@en ;
    skos:example "ai:Model eq NameOfAIModel"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "ai:Model"@en ;
    skos:scopeNote "ai:Model eq \"Qwen4.2\""@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:organisationalMeasure a skos:Concept ;
    skos:closeMatch dpv:OrganisationalMeasure ;
    skos:editorialNote "Source sheet names 'dpv:OrganisationalMeasure'; mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:OrganisationalMeasure"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:payAmount a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-payAmount> ;
    skos:exactMatch odrl:payAmount ;
    skos:example "PayAmount eq 100"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "PayAmount"@en ;
    skos:scopeNote "with unit property for currency"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:percentage a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-percentage> ;
    skos:exactMatch odrl:percentage ;
    skos:example "percentage lt 50"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "percentage"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:personalData a skos:Concept ;
    skos:closeMatch dpv:PersonalData ;
    skos:editorialNote "Source sheet names 'dpv:PersonalData' (Note details in DPV Extension \"Personal Data\": https://w3c-cg.github.io/dpv/2.3/dpv/modules/personal_data#sensitive-special-data); mapped during SKOS conversion."@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:PersonalData"@en ;
    skos:scopeNote "No Current Examples, but will occur"@en ;
