@prefix cv3: <https://odrl.codata.org/cv3/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://odrl.codata.org/cv3/collection/deprecated> a skos:Collection ;
    skos:member cv3:absolutePosition,
        cv3:absoluteSize,
        cv3:absoluteSpatialPosition,
        cv3:absoluteTemporalPosition,
        cv3:device,
        cv3:system ;
    skos:prefLabel "Left operands not to be used in CDIF"@en .

<https://odrl.codata.org/cv3/collection/leftOperands> a skos:Collection ;
    skos:member cv3:absolutePosition,
        cv3:absoluteSize,
        cv3:absoluteSpatialPosition,
        cv3:absoluteTemporalPosition,
        cv3:count,
        cv3:dateTime,
        cv3:delayPeriod,
        cv3:deliveryChannel,
        cv3:device,
        cv3:elapsedTime,
        cv3:event,
        cv3:fileFormat,
        cv3:industry,
        cv3:language,
        cv3:location,
        cv3:media,
        cv3:meteredTime,
        cv3:payAmount,
        cv3:percentage,
        cv3:product,
        cv3:purpose,
        cv3:recipient,
        cv3:resolution,
        cv3:spatial,
        cv3:spatialCoordinates,
        cv3:system,
        cv3:systemDevice,
        cv3:timeInterval,
        cv3:unitOfCount,
        cv3:version,
        cv3:virtualLocation ;
    skos:prefLabel "ODRL left operands used in CDIF"@en .

<https://odrl.codata.org/cv3/collection/noKnownUseCase> a skos:Collection ;
    skos:member cv3:media,
        cv3:product ;
    skos:prefLabel "Left operands without a known UKDS/Sikt use case"@en .

<https://odrl.codata.org/cv3/collection/restrictionCategories> a skos:Collection ;
    skos:member cv3:EnvironmentalRestriction,
        cv3:FinancialRestrictions,
        cv3:IdentityAndAccessRestrictions,
        cv3:LegalAndRegulatoryRestrictions,
        cv3:PersonRestrictions,
        cv3:RoleRestrictions,
        cv3:UsageContextRestrictions ;
    skos:prefLabel "Restriction categories (under investigation)"@en .

cv3:EnvironmentalRestriction a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "EnvironmentalRestriction"@en ;
    skos:scopeNote "Characteristics of ReUse Environment e.g. TRE (cf. \"Safe Settings\""@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:FinancialRestrictions a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "FinancialRestrictions"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:IdentityAndAccessRestrictions a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "IdentityAndAccessRestrictions"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:LegalAndRegulatoryRestrictions a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "LegalAndRegulatoryRestrictions"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:PersonRestrictions a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "PersonRestrictions"@en ;
    skos:scopeNote "e.g. Training Status (this implies a Duty Action of \"Complete Training\" - although not formally modelled"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:RoleRestrictions a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "RoleRestrictions"@en ;
    skos:scopeNote "How to handle multiple role context of a single agent (could be Individual or Organisation, or machine)"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:UsageContextRestrictions a skos:Concept ;
    skos:editorialNote "Status: Investigate DPV options (purpose plus other context like \"Research Project\""@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "UsageContextRestrictions"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:count a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-count> ;
    skos:exactMatch odrl:count ;
    skos:example "count eq 1"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "count"@en ;
    skos:scopeNote "How many times you can download"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:dateTime a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-dateTime> ;
    skos:exactMatch odrl:dateTime ;
    skos:example "dateTime eq 2026-11-04"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dateTime"@en ;
    skos:scopeNote "Multiple use cases"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:delayPeriod a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-delayPeriod> ;
    skos:exactMatch odrl:delayPeriod ;
    skos:example "delayPeriod eq 60 days"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "delayPeriod"@en ;
    skos:scopeNote "must wait a time period before action"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:deliveryChannel a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-deliveryChannel> ;
    skos:exactMatch odrl:deliveryChannel ;
    skos:example "deliveryChannel eq SafePod"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "deliveryChannel"@en ;
    skos:scopeNote "Data only access thr safepod network"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:elapsedTime a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-elapsedTime> ;
    skos:exactMatch odrl:elapsedTime ;
    skos:example "elapsedTime eq 3 years"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "elapsedTime"@en ;
    skos:scopeNote "How long you can exercise the Action"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:event a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-event> ;
    skos:exactMatch odrl:event ;
    skos:example "event lt odrl:policyUsage"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "event"@en ;
    skos:scopeNote "Duty must be completed before the Action is exercised"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:fileFormat a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-fileFormat> ;
    skos:exactMatch odrl:fileFormat ;
    skos:example "fileFormat eq SPSS"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "fileFormat"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:industry a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-industry> ;
    skos:exactMatch odrl:industry ;
    skos:example "industry eq Financial"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "industry"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:language a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-language> ;
    skos:exactMatch odrl:language ;
    skos:example "language eq de"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "language"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:location a skos:Concept ;
    skos:closeMatch dpv:Location ;
    skos:editorialNote "Source sheet names 'dpv:location' (DPV ODRL Profile); mapped to the DPV concept during SKOS conversion."@en ;
    skos:example "dpv:location eq IRI"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "dpv:location"@en ;
    skos:scopeNote "Handle user is in UK jurisdictyion for example"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:meteredTime a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-meteredTime> ;
    skos:exactMatch odrl:meteredTime ;
    skos:example "meteredTime eq 100 hours"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "meteredTime"@en ;
    skos:scopeNote "non-contigiouus blocks of time"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:payAmount a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-payAmount> ;
    skos:exactMatch odrl:payAmount ;
    skos:example "PayAmount eq 100"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "PayAmount"@en ;
    skos:scopeNote "with unit property for currency"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:percentage a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-percentage> ;
    skos:exactMatch odrl:percentage ;
    skos:example "percentage lt 50"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "percentage"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:purpose a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-purpose> ;
    skos:exactMatch odrl:purpose ;
    skos:example "purpose eq dpv:Purpose"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "purpose"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:recipient a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-recipient> ;
    skos:exactMatch odrl:recipient ;
    skos:example "recipient eq IRI"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "recipient"@en ;
    skos:scopeNote "e.g. which parties you might share with"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:resolution a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-resolution> ;
    skos:exactMatch odrl:resolution ;
    skos:example "resolution eq 1200"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "resolution"@en ;
    skos:scopeNote "e.g. print at 1200 DPI"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:spatial a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-spatial> ;
    skos:exactMatch odrl:spatial ;
    skos:example "spatial eq IRI"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "spatial"@en ;
    skos:scopeNote "\"named area\" - may not need"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:spatialCoordinates a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-spatialCoordinates> ;
    skos:exactMatch odrl:spatialCoordinates ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "spatialCoordinates"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:systemDevice a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-systemDevice> ;
    skos:exactMatch odrl:systemDevice ;
    skos:example "systemDevice eq TRE"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "systemDevice"@en ;
    skos:scopeNote "or safepod for example"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:timeInterval a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-timeInterval> ;
    skos:exactMatch odrl:timeInterval ;
    skos:example "timeInterval eq 100 d"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "timeInterval"@en ;
    skos:scopeNote "wait time before Action"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:unitOfCount a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-unitOfCount> ;
    skos:exactMatch odrl:unitOfCount ;
    skos:example "unitOfCount eq 1"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "unitOfCount"@en ;
    skos:scopeNote "e.g. once per user (as opposed to count)"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:version a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-version> ;
    skos:exactMatch odrl:version ;
    skos:example "version eq 3"@en ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "version"@en ;
    skos:scopeNote "Only version 3 of the asset for example"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:virtualLocation a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-virtualLocation> ;
    skos:exactMatch odrl:virtualLocation ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "virtualLocation"@en ;
    skos:scopeNote "e.g. an IP range"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:absolutePosition a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-absolutePosition> ;
    owl:deprecated true ;
    skos:editorialNote "Marked 'DON'T USE' in source sheet."@en ;
    skos:exactMatch odrl:absolutePosition ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "absolutePosition"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:absoluteSize a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-absoluteSize> ;
    owl:deprecated true ;
    skos:editorialNote "Marked 'DON'T USE' in source sheet."@en ;
    skos:exactMatch odrl:absoluteSize ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "absoluteSize"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:absoluteSpatialPosition a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-absoluteSpatialPosition> ;
    owl:deprecated true ;
    skos:editorialNote "Marked 'DON'T USE' in source sheet."@en ;
    skos:exactMatch odrl:absoluteSpatialPosition ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "absoluteSpatialPosition"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:absoluteTemporalPosition a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-absoluteTemporalPosition> ;
    owl:deprecated true ;
    skos:editorialNote "Marked 'DON'T USE' in source sheet."@en ;
    skos:exactMatch odrl:absoluteTemporalPosition ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "absoluteTemporalPosition"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:device a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-device> ;
    owl:deprecated true ;
    skos:editorialNote "Marked 'DEPRECATED' in source sheet."@en ;
    skos:exactMatch odrl:device ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "device"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:media a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-media> ;
    skos:editorialNote "ukds/SIKT HAVE NO USE CASE BUT THERE MAY BE ONE ELSEWHERE"@en ;
    skos:exactMatch odrl:media ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "media"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:product a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-product> ;
    skos:editorialNote "ukds/SIKT HAVE NO USE CASE BUT THERE MAY BE ONE ELSEWHERE"@en ;
    skos:exactMatch odrl:product ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "product"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

cv3:system a skos:Concept ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-system> ;
    owl:deprecated true ;
    skos:editorialNote "Marked 'DEPRECATED' in source sheet."@en ;
    skos:exactMatch odrl:system ;
    skos:inScheme <https://odrl.codata.org/cv3> ;
    skos:prefLabel "system"@en ;
    skos:topConceptOf <https://odrl.codata.org/cv3> .

<https://odrl.codata.org/cv3> a skos:ConceptScheme ;
    dct:created "2026-11-04"^^xsd:date ;
    dct:description "Other constraints describing the scope of applicability of a CDIF access policy: the ODRL left operands selected for CDIF, and broader restriction categories (environment, legal, usage context, person, identity, role, financial) still under investigation."@en ;
    dct:source <https://www.w3.org/TR/odrl-vocab/#term-LeftOperand> ;
    dct:title "CDIF Other Constraints (CV3)"@en ;
    skos:hasTopConcept cv3:EnvironmentalRestriction,
        cv3:FinancialRestrictions,
        cv3:IdentityAndAccessRestrictions,
        cv3:LegalAndRegulatoryRestrictions,
        cv3:PersonRestrictions,
        cv3:RoleRestrictions,
        cv3:UsageContextRestrictions,
        cv3:absolutePosition,
        cv3:absoluteSize,
        cv3:absoluteSpatialPosition,
        cv3:absoluteTemporalPosition,
        cv3:count,
        cv3:dateTime,
        cv3:delayPeriod,
        cv3:deliveryChannel,
        cv3:device,
        cv3:elapsedTime,
        cv3:event,
        cv3:fileFormat,
        cv3:industry,
        cv3:language,
        cv3:location,
        cv3:media,
        cv3:meteredTime,
        cv3:payAmount,
        cv3:percentage,
        cv3:product,
        cv3:purpose,
        cv3:recipient,
        cv3:resolution,
        cv3:spatial,
        cv3:spatialCoordinates,
        cv3:system,
        cv3:systemDevice,
        cv3:timeInterval,
        cv3:unitOfCount,
        cv3:version,
        cv3:virtualLocation .

